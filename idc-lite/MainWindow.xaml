<Window x:Class="idc_lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDC-Lite"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        BorderThickness="0"
        Background="Transparent"
        Icon="pack://application:,,,/logo.png"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Icon geometries -->
        <Geometry x:Key="IconSettings">M12 2L13.5 5.5L17 4L15.5 7.5L19 9L15.5 10.5L17 14L13.5 12.5L12 16L10.5 12.5L7 14L8.5 10.5L5 9L8.5 7.5L7 4L10.5 5.5L12 2Z M12 9.5A2.5 2.5 0 1 0 12 14.5 2.5 2.5 0 1 0 12 9.5Z</Geometry>
        <Geometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</Geometry>
    </Window.Resources>

    <!-- Rounded border with shadow -->
    <Border Background="#1e1e2e"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="0"
                              Color="Black"
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Border Grid.Row="0" Background="#181825"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                <TextBlock x:Name="HeaderTitle"
                           Text="IDC-Lite"
                           Foreground="#89b4fa"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Settings -->
                    <Button Name="SettingsBtn"
                            Width="44" Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SettingsButton_Click"
                            MouseEnter="WindowBtn_MouseEnter"
                            MouseLeave="WindowBtn_MouseLeave">
                        <Path Data="{StaticResource IconSettings}"
                              Fill="#6c7086"
                              Stretch="Uniform"
                              Width="15" Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                    <!-- Close -->
                    <Button Name="CloseBtn"
                            Width="44" Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            MouseEnter="CloseBtn_MouseEnter"
                            MouseLeave="CloseBtn_MouseLeave">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="#6c7086"
                              StrokeThickness="1.5"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENT ===== -->
            <Grid Grid.Row="1" Margin="28,16,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status badge -->
                <Border Grid.Row="0"
                        HorizontalAlignment="Center"
                        Background="#313244"
                        CornerRadius="12"
                        Padding="16,6,16,6"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="7" Height="7"
                                 Fill="#585b70"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Searching for device..."
                                   Foreground="#a6adc8"
                                   FontSize="11"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- Temperature -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="TemperatureValue"
                               Text="—"
                               FontSize="72"
                               FontWeight="Thin"
                               FontFamily="Segoe UI Light"
                               Foreground="#cdd6f4"
                               TextAlignment="Center"/>
                    <TextBlock Text="°C"
                               FontSize="18"
                               FontWeight="Light"
                               FontFamily="Segoe UI"
                               Foreground="#6c7086"
                               TextAlignment="Center"
                               Margin="0,-8,0,0"/>
                </StackPanel>

                <!-- Bottom panel -->
                <Border Grid.Row="2"
                        Background="#181825"
                        CornerRadius="8"
                        Padding="16,8,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="VersionLabel"
                                   Text="IDC-Lite v1.0"
                                   Foreground="#45475a"
                                   FontSize="10"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="UpdateIntervalText"
                                   Text=""
                                   Foreground="#45475a"
                                   FontSize="10"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>